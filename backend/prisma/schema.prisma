generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Consultation {
  id        Int      @id @default(autoincrement())
  name      String   @default("")
  phone     String   @default("")
  date      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}
